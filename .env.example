# mc-pack-builder-mcp 可配置项（复制为 .env 后按需修改，重启生效）
# 优先级：环境变量 > .env 文件 > 内置默认值

# Modrinth API 根地址，支持自建网关/代理
# PACK_BUILDER_MODRINTH_API_BASE=https://api.modrinth.com/v2

# 请求 User-Agent（Modrinth 要求标明来源）
# PACK_BUILDER_USER_AGENT=mc-pack-builder-mcp/1.1

# 分卷导出时每卷的最大体积（MB）
# PACK_BUILDER_VOLUME_MAX_MB=256

# 解压嵌套压缩包时跳过的顶层目录（逗号分隔）
# PACK_BUILDER_SKIP_DIRS=mods,config,resourcepacks,shaderpacks,saves,datapacks,worlds
