{
  "name": "mc-pack-builder-mcp",
  "version": "1.1.0",
  "description": "MCP server for Minecraft modpack building. Create pack.json, search mods, resolve dependencies, and manage pack structure.",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "mc-pack-builder-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/pack-rules.json','dist/pack-rules.json')\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node test.js",
    "test:unit": "tsx --test __tests__/*.test.ts",
    "test:all": "npm run test:unit && npm run test"
  },
  "keywords": [
    "minecraft",
    "modpack",
    "mcp",
    "model-context-protocol",
    "fabric",
    "forge",
    "pack-builder"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0"
  }
}
